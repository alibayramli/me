---
import { Image } from 'astro:assets'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { ArrowLeft, Clock3 } from 'lucide-react'
import BlogLayout from '@/layouts/BlogLayout.astro'
import {
  formatBlogDate,
  getPostUrl,
  getReadingMinutes,
  isPublishedPost,
  slugifyTag,
} from '@/lib/blog'
import { SITE_PROFILE, withBasePath } from '@/lib/portfolio-data'

type Props = {
  post: CollectionEntry<'blog'>
}

export async function getStaticPaths() {
  const now = new Date()
  const posts = await getCollection('blog')
  const visiblePosts = posts.filter((post) => import.meta.env.DEV || isPublishedPost(post, now))

  return visiblePosts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const readingMinutes = getReadingMinutes(post.body)
const site = Astro.site ?? new URL(SITE_PROFILE.siteUrl)
const canonicalUrl = new URL(getPostUrl(post), site)
const socialImageUrl = post.data.cover
  ? new URL(post.data.cover.src, site)
  : new URL(`${import.meta.env.BASE_URL}og-card.png`, site)
const publishDate = post.data.publishDate.toISOString()
const updatedDate = post.data.updatedDate?.toISOString()
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishDate,
  dateModified: updatedDate ?? publishDate,
  mainEntityOfPage: canonicalUrl.href,
  image: socialImageUrl.href,
  author: {
    '@type': 'Person',
    name: SITE_PROFILE.name,
    url: SITE_PROFILE.siteUrl,
  },
  keywords: post.data.tags.join(', '),
}
---

<BlogLayout
  title={`${post.data.title} | ${SITE_PROFILE.name}`}
  description={post.data.description}
  image={post.data.cover?.src}
  imageAlt={post.data.coverAlt}
  pageType="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  tags={post.data.tags}
  structuredData={structuredData}
>
  <article class="px-6 pb-24 pt-32 md:pt-36">
    <div class="mx-auto max-w-3xl">
      <a
        href={withBasePath('blog/')}
        class="mb-10 inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground transition-colors hover:text-primary"
      >
        <ArrowLeft className="h-4 w-4" />
        All posts
      </a>

      <header>
        <div class="mb-5 flex flex-wrap items-center gap-2">
          {
            import.meta.env.DEV && post.data.draft ? (
              <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-700 dark:text-amber-300">
                Draft preview
              </span>
            ) : null
          }
          {
            post.data.tags.map((tag) => (
              <a
                href={withBasePath(`blog/tags/${slugifyTag(tag)}/`)}
                class="rounded-full border border-primary/20 bg-primary/[0.07] px-3 py-1.5 text-xs font-semibold text-primary transition-colors hover:bg-primary/[0.13]"
              >
                {tag}
              </a>
            ))
          }
        </div>

        <h1 class="text-4xl font-bold leading-[1.08] md:text-6xl">
          {post.data.title}
        </h1>
        <p class="mt-6 text-lg leading-8 text-muted-foreground md:text-xl">
          {post.data.description}
        </p>
        <div
          class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-border/70 pb-8 text-sm text-muted-foreground"
        >
          <span>{SITE_PROFILE.name}</span>
          <time datetime={publishDate}>{formatBlogDate(post.data.publishDate)}</time>
          <span class="inline-flex items-center gap-1.5">
            <Clock3 className="h-4 w-4" />
            {readingMinutes} min read
          </span>
          {
            post.data.updatedDate ? (
              <span>Updated {formatBlogDate(post.data.updatedDate)}</span>
            ) : null
          }
        </div>
      </header>

      {
        post.data.cover ? (
          <figure class="mt-10 overflow-hidden rounded-3xl border border-border/70 bg-card">
            <Image
              src={post.data.cover}
              alt={post.data.coverAlt ?? ''}
              widths={[720, 1080, 1440]}
              sizes="(max-width: 768px) 100vw, 768px"
              class="h-auto w-full"
            />
          </figure>
        ) : null
      }

      <div class="blog-prose prose prose-slate mt-12 max-w-none dark:prose-invert">
        <Content />
      </div>

      <footer class="mt-16 rounded-3xl border border-border/70 bg-card/75 p-7">
        <h2 class="text-xl font-bold">Continue the conversation</h2>
        <p class="mt-2 leading-7 text-muted-foreground">
          If you are working through similar platform or developer-experience problems, I would be
          glad to compare notes.
        </p>
        <div class="mt-5 flex flex-wrap gap-4">
          <a
            href={`mailto:${SITE_PROFILE.email}`}
            class="inline-flex rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
          >
            Email me
          </a>
          <a
            href={withBasePath('blog/')}
            class="inline-flex rounded-full border border-border px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-accent"
          >
            More posts
          </a>
        </div>
      </footer>
    </div>
  </article>
</BlogLayout>
