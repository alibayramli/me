---
import PortfolioApp from '@/components/PortfolioApp'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getBlogPosts, toPostSummary } from '@/lib/blog'

const latestPosts = (await getBlogPosts({ includeDrafts: false })).slice(0, 1).map(toPostSummary)
const title = 'Ali Bayramli | Senior Full-Stack Engineer'
const description =
  'Portfolio of Ali Bayramli, a senior full-stack engineer with 8+ years building developer platforms and internal tools across fintech and enterprise.'
---

<BaseLayout title={title} description={description} preloadProfileImage>
  <PortfolioApp client:load posts={latestPosts} />
</BaseLayout>
