---
import type { CollectionEntry } from 'astro:content'
import { Clock3 } from 'lucide-react'
import { formatBlogDate, getPostUrl, getReadingMinutes, slugifyTag } from '@/lib/blog'
import { withBasePath } from '@/lib/portfolio-data'

type Props = {
  post: CollectionEntry<'blog'>
  placement: 'blog-index' | 'tag-index'
  showDraft?: boolean
}

const { post, placement, showDraft = false } = Astro.props
const readingMinutes = getReadingMinutes(post.body)
---

<article
  class="glass group relative flex h-full flex-col rounded-3xl border border-border/70 p-6 transition-transform duration-300 hover:-translate-y-1"
>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    {
      showDraft && post.data.draft ? (
        <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:text-amber-300">
          Draft
        </span>
      ) : null
    }
    {
      post.data.tags.slice(0, 3).map((tag) => (
        <a
          href={withBasePath(`blog/tags/${slugifyTag(tag)}/`)}
          class="relative z-10 rounded-full border border-primary/20 bg-primary/[0.07] px-2.5 py-1 text-xs font-semibold text-primary transition-colors hover:bg-primary/[0.13]"
        >
          {tag}
        </a>
      ))
    }
  </div>

  <h2 class="text-2xl font-bold leading-tight">
    <a
      href={getPostUrl(post)}
      class="transition-colors after:absolute after:inset-0 hover:text-primary"
      data-umami-event="article-open"
      data-umami-event-article={getPostUrl(post)}
      data-umami-event-placement={placement}
    >
      {post.data.title}
    </a>
  </h2>
  <p class="mt-3 flex-1 leading-7 text-muted-foreground">
    {post.data.description}
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
    <time datetime={post.data.publishDate.toISOString()}>
      {formatBlogDate(post.data.publishDate)}
    </time>
    <span class="inline-flex items-center gap-1.5">
      <Clock3 className="h-4 w-4" />
      {readingMinutes} min read
    </span>
  </div>
</article>
