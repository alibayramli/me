---
import type { CollectionEntry } from 'astro:content'
import BlogPostCard from '@/components/blog/BlogPostCard'
import { toPostSummary } from '@/lib/blog'

type Props = {
  post: CollectionEntry<'blog'>
  placement: 'blog-index' | 'tag-index'
  featured?: boolean
  showDraft?: boolean
}

const { post, placement, featured = false, showDraft = false } = Astro.props
---

<BlogPostCard
  post={toPostSummary(post)}
  placement={placement}
  featured={featured}
  showDraft={showDraft && post.data.draft}
/>
